# Copy to .env.local for local development. Never commit a real .env file.

# Leave unset to run the frontend in demo mode against the bundled sample
# material (no AWS session needed). Set it to the API Gateway stage URL that
# `backend/template.yaml` outputs to generate real recaps.
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
