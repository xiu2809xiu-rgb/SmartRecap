# Copy to .env.local for local development. Never commit a real .env file.

# Leave unset to run the frontend in demo mode against the bundled sample
# material (no AWS session needed). Set it to your deployed API to generate
# real recaps — see docs/EC2-DEPLOYMENT.md or docs/AWS-DEPLOYMENT.md.
# VITE_API_BASE_URL=http://your-api-host

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your site to
# "Authorised JavaScript origins" — http://localhost:5173 for development.
#
# The SAME value must be set as GOOGLE_CLIENT_ID on the backend, which verifies
# the token's audience against it. A mismatch means every Google sign-in fails.
#
# Unset: the Google button remains visible but disabled with a clear setup
# message in live mode; demo mode uses a clearly labelled placeholder account.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
