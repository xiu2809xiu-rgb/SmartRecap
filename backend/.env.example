# Copy this file to .env. Never commit the real key.
AZURE_AI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_AI_API_KEY=replace-with-a-new-rotated-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_FAST_DEPLOYMENT=gpt-5.6-sol
# Optional separate Azure AI Services endpoint/key for Content Understanding.
AZURE_CONTENT_ENDPOINT=
AZURE_CONTENT_API_KEY=
AZURE_CONTENT_ANALYZER_ID=prebuilt-layout
# Gemini formats extracted text into the recap; Azure gpt-5.6-sol remains the chatbot.
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Optional secondary chatbot fallback if Azure is unavailable.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
DEMO_MODE=false

# Google sign-in. Must be the SAME OAuth 2.0 Client ID as VITE_GOOGLE_CLIENT_ID
# on the frontend: the ID token's audience is checked against this value, so a
# mismatch rejects every sign-in with "could not be verified".
# Leave blank to disable Google sign-in on this deployment.
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_FILE_MB=25
ENABLE_PADDLE_OCR=true
# CPU-only Pix2Text formula/layout recognition. It is lazy and scans only selected math-heavy PDF pages.
ENABLE_MATH_OCR=true
MATH_OCR_MAX_PAGES=8
OCR_MAX_IMAGES=24
OCR_TIME_BUDGET_SECONDS=120
AI_TIMEOUT_SECONDS=300
# Optional private S3 direct uploads and generated-result snapshots. EC2 should use its instance role.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=smartrecap
# Optional shared durable state. Use the DynamoDB table output from fastapi-data.yaml.
TABLE_NAME=
# Optional, nonessential study illustrations generated from a short sanitized visual brief.
# Current Pollinations deployments may require a key even when older endpoints did not; blank sends no auth header.
ENABLE_STUDY_IMAGES=false
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MODEL=flux
POLLINATIONS_API_KEY=