# Installed by setup-ec2.sh, which replaces __REPO_ROOT__ with the clone path.
[Unit]
Description=SmartRecap FastAPI OCR and AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=/etc/smartrecap.env
Environment=HOME=/var/lib/smartrecap
Environment=XDG_CACHE_HOME=/var/lib/smartrecap/cache
ExecStart=__REPO_ROOT__/backend/.venv/bin/python -m uvicorn app.main:app --app-dir __REPO_ROOT__/backend --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartrecap
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /var/lib/smartrecap

[Install]
WantedBy=multi-user.target
