# systemd unit for the SmartRecap API on EC2.
#
# Why this instead of `node src/server.js` in an SSH session: that process dies
# the moment the connection drops, and it does not come back when the instance
# restarts. Learner Lab stops your instance at the end of every session, so
# without this you are SSHing in to restart the API before every demo.
#
#   sudo cp infra/smartrecap.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smartrecap
#   sudo systemctl status smartrecap
#   sudo journalctl -u smartrecap -f          # follow the logs
#
# `enable` is the important word — it is what makes the API come back on boot.

[Unit]
Description=SmartRecap API
Documentation=https://gitlab.com/LEBRONISGOAT23/smartrecap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/smartrecap/backend

# Secrets live here, not in the unit file — a unit file is world-readable and
# `systemctl cat` prints it. Create it with `sudo chmod 600`.
EnvironmentFile=/etc/smartrecap.env

ExecStart=/usr/bin/node src/server.js

# A generation job runs in-process, so a crash mid-job loses it. Restarting
# promptly matters more than a clean shutdown here.
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartrecap

# The API reads and writes nothing on local disk — uploads go straight to S3 —
# so it can be locked down hard.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
